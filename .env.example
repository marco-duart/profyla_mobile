# URL da API Rails (profyla_api). Emulador Android: http://10.0.2.2:3000. Celular físico: o IP da sua máquina na rede.
# Suba a API com RAILS_ENV=development explícito (o .env dela tem RAILS_ENV=production).
EXPO_PUBLIC_API_URL=http://localhost:3000
# Site web do Profyla (profyla_front): as páginas de confirmação de e-mail e de redefinição de senha ficam lá.
# Precisa estar em FRONTEND_URL da API (redirect_whitelist do devise_token_auth).
EXPO_PUBLIC_WEB_URL=http://localhost:5173
