{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.profyla.app.br",
        "EXPO_PUBLIC_WEB_URL": "https://profyla.app.br"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.profyla.app.br",
        "EXPO_PUBLIC_WEB_URL": "https://profyla.app.br"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
